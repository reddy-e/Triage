# X-RayTriage AI Environment Configuration
# Copy this file to .env for local overrides (never commit secrets to version control)

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Model Configuration
MODEL_NAME=densenet121
NUM_CLASSES=4
MODEL_WEIGHTS_PATH=models/model_weights.pth
FORCE_DEMO_MODE=False
DEVICE=cpu

# Triage Decision Engine Thresholds (Configurable Prototype Thresholds)
HIGH_PRIORITY_THRESHOLD=0.80
MEDIUM_PRIORITY_THRESHOLD=0.50

# Upload Security Constraints
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg

# Storage
DATABASE_URL=sqlite:///./xray_triage.db
UPLOAD_DIR=uploads
